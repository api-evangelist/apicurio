      "item": [
        {
          "id": "cd1701cc-e2d8-4b62-a2a7-05a951ab01b6",
          "name": "Detect references in content",
          "request": {
            "name": "Detect references in content",
            "description": {
              "content": "Analyzes the provided content and returns a list of external references found within it.  The artifact type is used to determine the appropriate reference detection strategy.  If no artifact type is provided, the system will attempt to auto-detect it from the content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "content",
                "references"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "artifactType",
                  "value": "<string>",
                  "description": "The type of artifact represented by the content.  If not provided, the server will attempt to auto-detect the type from the content."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"<string>\",\n  \"contentType\": \"<string>\",\n  \"references\": [\n    {\n      \"artifactId\": \"<string>\",\n      \"groupId\": \"<string>\",\n      \"name\": \"<string>\",\n      \"version\": \"<string>\"\n    },\n    {\n      \"artifactId\": \"<string>\",\n      \"groupId\": \"<string>\",\n      \"name\": \"<string>\",\n      \"version\": \"<string>\"\n    }\n  ],\n  \"encoding\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "65d254bf-5ea5-42ed-b67d-30640a1e5457",
              "name": "List of references detected in the provided content.  Each reference will have only the `name` field populated.  The `name` value corresponds to the reference string found in the content (e.g. a JSON Schema `$ref` value, a Protobuf import path, or an Avro type name).",
              "originalRequest": {
                "url": {
                  "path": [
                    "content",
                    "references"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "artifactType",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"content\": \"\",\n  \"contentType\": \"<string>\",\n  \"references\": [\n    {\n      \"groupId\": \"mygroup\",\n      \"artifactId\": \"13842090-2ce3-11ec-8d3d-0242ac130003\",\n      \"version\": \"2\",\n      \"name\": \"foo.bar.Open\"\n    },\n    {\n      \"groupId\": \"mygroup\",\n      \"artifactId\": \"13842090-2ce3-11ec-8d3d-0242ac130003\",\n      \"version\": \"2\",\n      \"name\": \"foo.bar.Open\"\n    }\n  ],\n  \"encoding\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"groupId\": \"mygroup\",\n    \"artifactId\": \"13842090-2ce3-11ec-8d3d-0242ac130003\",\n    \"version\": \"2\",\n    \"name\": \"foo.bar.Open\"\n  },\n  {\n    \"groupId\": \"mygroup\",\n    \"artifactId\": \"13842090-2ce3-11ec-8d3d-0242ac130003\",\n    \"version\": \"2\",\n    \"name\": \"foo.bar.Open\"\n  }\n]",
